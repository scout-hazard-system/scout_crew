# Secrets / local env
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
build/
.venv/
venv/

# Tools / caches
.crewai_storage/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.DS_Store
*.swp
*~

# Runtime outputs (keep directory via .gitkeep + verification summaries)
output/*
!output/.gitkeep
!output/verification/
!output/verification/**/
!output/verification/**/*.json
!output/verification/**/*.md
output/verification/**/*.out
output/verification/**/*.err
output/verification/**/*.log
output/verification/**/*.txt
!output/verification/**/inputs.json

# Editor
.idea/
.vscode/
*.code-workspace

# Blackboard local DB (multi-machine server may use shared path)
data/blackboard/*.db
data/blackboard/*.db-*
!data/blackboard/.gitkeep
