# Local/mesh CrewAI + Ollama. Copy to .env and adjust if needed.
# Do NOT point these at cloud providers if you want zero outside token usage.
# Default weight lineage: Qwen3 (qwen3:8b) — not Llama/Meta.

# Primary Ollama on THIS machine (Linux specialists / training host)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OPENAI_API_KEY=ollama
OPENAI_API_BASE=http://127.0.0.1:11434/v1
OPENAI_BASE_URL=http://127.0.0.1:11434/v1

MODEL=ollama/qwen3:8b
OLLAMA_MODEL_MANAGER=ollama/scout-hermes-hc1.1.0
OLLAMA_MODEL_CORE=ollama/scout-core1.0.5
OLLAMA_MODEL_VET=ollama/scout-vet1.0.6
OLLAMA_MODEL_ALERT=ollama/scout-alert
OLLAMA_MODEL_INTEL=ollama/scout-intel
OLLAMA_MODEL_RANK=ollama/scout-rank
OLLAMA_MODEL_DEV=ollama/scout-dev
OLLAMA_MODEL_BASE=ollama/qwen3:8b
OLLAMA_MODEL_HERMES=ollama/scout-hermes-hc1.1.0

# Privacy defaults: CrewAI usage telemetry OFF, run traces OFF.
# Tracing writes prompt + response content to local .crewai_storage/ runs; on a
# shared or backed-up host that is an operator-data disclosure risk. Turn either
# on deliberately, per-run, when you actually want the data.
CREWAI_DISABLE_TELEMETRY=true
CREWAI_STORAGE_DIR=.crewai_storage
CREWAI_TRACING_ENABLED=false

# --- Split mesh routing (Scout Mesh WireGuard, scoutwg0 / 10.66.0.0/16) ---
# When SCOUT_PEER_OLLAMA_OPENAI is set, manager + hermes resolve models on the peer.
# Specialists stay on OLLAMA_BASE_URL unless you set OLLAMA_HOST_* for them.
# Peer Ollama is locked to the scoutwg0 mesh IP set (NOT LAN):
#   use 10.66.2.x — the peer's LAN IP:11434 is expected DOWN.
# The hub (10.66.2.3 by default) hosts the map server (:18080) + blackboard (:8765).
# SCOUT_MESH_HUB_ADDRESS=10.66.2.3
# SCOUT_MESH_IFACE=scoutwg0
# SCOUT_MESH_CIDR=10.66.0.0/16
# SCOUT_PEER_MESH_IP=10.66.2.4
# SCOUT_PEER_OLLAMA_OPENAI=http://10.66.2.4:11434/v1
# OLLAMA_HOST_HERMES=http://10.66.2.4:11434
# OLLAMA_HOST_MANAGER=http://10.66.2.4:11434
# OLLAMA_HOST_CORE=http://127.0.0.1:11434
# OLLAMA_HOST_ALERT=http://127.0.0.1:11434
# OLLAMA_HOST_INTEL=http://127.0.0.1:11434
# OLLAMA_HOST_VET=http://127.0.0.1:11434
# OLLAMA_HOST_RANK=http://127.0.0.1:11434
# OLLAMA_HOST_DEV=http://127.0.0.1:11434

# Multi-machine blackboard (leave URL empty for local SQLite)
# SCOUT_BLACKBOARD_URL=http://10.66.2.3:8765
# SCOUT_BLACKBOARD_PATH=/home/gibi/Desktop/scout_crew/data/blackboard/scout_blackboard.db
# SCOUT_BLACKBOARD_HOST=0.0.0.0
# SCOUT_BLACKBOARD_PORT=8765
#
# Blackboard key authorization (token auth framework; see blackboard/README.md):
#   Set SCOUT_BLACKBOARD_TOKEN_SECRET on the hub server; clients send a role-scoped
#   token via SCOUT_BLACKBOARD_TOKEN. Tokens are minted through POST /v1/keys/authorize
#   (proof-gated) or POST /v1/keys/issue (master-secret, manager/CLI). No bootstrap
#   or deploy-time minting. Sandbox policy (pipeline writers) defaults to alert role.
# SCOUT_BLACKBOARD_TOKEN_SECRET=change-me
# Without a secret the server refuses any non-loopback bind (fail closed).
# Only for an isolated lab: SCOUT_BLACKBOARD_ALLOW_NOAUTH=1
# SCOUT_BLACKBOARD_ENTRY_TOKEN=change-me-entry
# SCOUT_BLACKBOARD_SANDBOX_WRITERS=alert
# SCOUT_BLACKBOARD_TOKEN=  # client-side: role-scoped token issued by the hub
#
# Memory mode: run the blackboard store in RAM for a per-peer sandbox context
#   (the hub stays file-backed). Enable with SCOUT_BLACKBOARD_MEMORY=1 on the server.

# Map server (route/geo source of truth; read-only tools). Resolved in order:
#   SCOUT_MAP_BASE_URL -> SCOUT_BACKEND_URL -> http://{SCOUT_MESH_HUB_ADDRESS}:18080
# SCOUT_MAP_BASE_URL=http://10.66.2.3:18080

# Multi-machine Scout Mesh (WireGuard) integration
# SCOUT_MESH_HUB_ADDRESS=10.66.2.3
# SCOUT_MESH_IFACE=scoutwg0
# SCOUT_MESH_CIDR=10.66.0.0/16
# SCOUT_PEER_MESH_IP=10.66.2.4
# SCOUT_BLACKBOARD_URL=http://10.66.2.3:8765
# SCOUT_SHARED_OLLAMA_OPENAI=http://10.66.2.3:11434/v1
# SCOUT_PEER_OLLAMA_OPENAI=http://10.66.2.4:11434/v1
