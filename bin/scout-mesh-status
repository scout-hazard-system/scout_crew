# Quick mesh health: Tailscale + Ollama + blackboard + peer probes
set -u
ME="${SCOUT_TAILSCALE_IP:-$(tailscale ip -4 2>/dev/null | head -1)}"
WIN="${SCOUT_PEER_WINDOWS_IP:-100.82.130.47}"
echo "me=$ME win=$WIN"
echo -n "tailscale: "; tailscale status --json 2>/dev/null | python3 -c 'import sys,json;d=json.load(sys.stdin);print(d.get("BackendState"), d.get("Self",{}).get("Online"))' 2>/dev/null || tailscale status | head -3
echo -n "ollama local: "; curl -sS --connect-timeout 2 http://127.0.0.1:11434/api/version || echo DOWN
echo
echo -n "ollama TS self: "; curl -sS --connect-timeout 2 "http://${ME}:11434/api/version" || echo DOWN
echo
echo -n "ollama TS win:  "; curl -sS --connect-timeout 2 "http://${WIN}:11434/api/version" || echo DOWN
echo
echo -n "blackboard local: "; curl -sS --connect-timeout 2 http://127.0.0.1:8765/health || echo DOWN
echo
echo -n "blackboard TS:    "; curl -sS --connect-timeout 2 "http://${ME}:8765/health" || echo DOWN
echo
echo -n "ssh win:22 "; timeout 2 bash -c "echo >/dev/tcp/${WIN}/22" 2>/dev/null && echo open || echo closed
echo -n "ssh me:22  "; timeout 2 bash -c "echo >/dev/tcp/${ME}/22" 2>/dev/null && echo open || echo closed
echo
echo "== role endpoints (host-aware) =="
if command -v uv >/dev/null 2>&1 && [[ -d "${SCOUT_CREW_ROOT:-$HOME/Desktop/scout_crew}" ]]; then
  (
    cd "${SCOUT_CREW_ROOT:-$HOME/Desktop/scout_crew}" || exit 0
    # shellcheck disable=SC1091
    [[ -f .env ]] && set -a && source .env && set +a
    export SCOUT_PEER_OLLAMA_OPENAI="${SCOUT_PEER_OLLAMA_OPENAI:-http://${WIN}:11434/v1}"
    uv run python -c 'from scout_crew.local_llms import status; import json; s=status(); print(json.dumps({"weight_lineage": s.get("weight_lineage"), "role_endpoints": s.get("role_endpoints"), "hosts": {k: {"up": v.get("up"), "n_models": len(v.get("models") or [])} for k,v in (s.get("hosts") or {}).items()}}, indent=2))' 2>/dev/null || echo "(role endpoint probe skipped)"
  )
else
  echo "(uv/scout_crew not available for role probe)"
fi
